# ═══════════════════════════════════════════════════════════════
# Copie para .env e preencha os valores reais.
# NUNCA commite .env — está no .gitignore.
# ═══════════════════════════════════════════════════════════════

# ─── Banco de dados (PostgreSQL compartilhado — postgres_default network) ──
# No droplet: postgres é o container name, acessível via postgres_net
DB_URL=jdbc:postgresql://postgres:5432/main?currentSchema=finance_control
DB_USERNAME=app_user_finance_control
# Gere com: openssl rand -hex 32
DB_PASSWORD=<256-bit-hex>

# ─── Aplicação ────────────────────────────────────────────────
# Gere com: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
API_KEY=<256-bit-base64url>
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ─── Flyway — forçar uso do schema finance_control ───────────
SPRING_FLYWAY_SCHEMAS=finance_control
